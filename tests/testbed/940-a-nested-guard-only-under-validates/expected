# Rails merges a validator's own hash into its options only under
# `validates` and `validates!` (DEC-711). `validates!`'s guard was not read,
# so `bang_skip?` was unreferenced; `validates_with`'s and
# `validates_length_of`'s hashes are the validator's data, and reading an
# `if:` in them made `rule_data` and `tokenizer_data` convention-only, `clear`,
# hiding two dead methods.
dead app/models/widget.rb Widget=unreferenced

def app/models/widget.rb:2:20 status=resolved site=lib/helper.rb:1
def app/models/widget.rb:3:12 status=resolved name=helper site=lib/helper.rb:1
# A require nothing satisfies is no file, not the nearest name.
def app/models/widget.rb:4:13 status=residue name=nowhere reason=nowhere exit=1
# Outside the string, the call is the call.
def app/models/widget.rb:2:5 name=require_relative

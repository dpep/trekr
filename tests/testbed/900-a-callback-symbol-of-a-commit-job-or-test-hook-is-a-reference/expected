dead app/jobs/widget_job.rb WidgetJob#prepare=convention-only WidgetJob#log_enqueue=convention-only WidgetJob#wrap=convention-only WidgetJob#lonely=unreferenced~
dead test WidgetTest#build_widget=convention-only WidgetTest#drop_widget=convention-only

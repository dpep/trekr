# DEC-445 typed every top-level call as `main`, an Object, so a file Ruby
# evaluates on another object lost its calls: a Rake task's `task` went to
# a `def task` in an `instance_eval` block, a plugin's `register_asset` was
# ruled out "no such name", and a Gemfile's `gem` was Kernel's. Rake extends
# main with Rake::DSL; a Gemfile is Bundler's; a file whose top-level call
# main does not answer runs on something else; a def in a block is not
# Object's.
def lib/tasks/build.rake:1:1 status=resolved owner=Rake::DSL via=main
def lib/tasks/build.rake:3:1 status=resolved owner=Kernel via=main
def Gemfile:2:1 status=residue
refs Rake::DSL#task confirmed=1 possible=0 excluded=0
refs Plugin::Instance#register_asset possible=1 excluded=0

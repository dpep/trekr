# it listed tracked files only: an untracked view, YAML config, script or
# routes file naming a method left it `unreferenced`, clear, and an
# untracked `config/routes.rb` the index reads was "no routes file read".
# They list files as the index does now, untracked ones included.
dead app Widget#title_from_view=unreferenced~view Widget#build_from_config=unreferenced~config/widgets.yml:2 Widget#run_from_script=unreferenced~exe/tool Widget#lonely=unreferenced~ WidgetsController#archive=convention-only WidgetsController#forgotten=unreferenced!~file

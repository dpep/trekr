# ActiveSupport::Concern extends its includers with the `ClassMethods` it
# finds by name, so that module is reached as its concern is and is no
# candidate (DEC-720); Rails mixes every helper module into the views, which
# no reference names. A `ClassMethods` of a plain module is no concern's.
dead app Sizable::ClassMethods=none WidgetsHelper=convention-only Plain::ClassMethods=unreferenced

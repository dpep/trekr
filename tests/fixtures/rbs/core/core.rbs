  def rindex: (Regexp | string pattern, ?int offset) -> Integer?
  # <!--
  #   - rjust(size, pad_string = ' ') -> new_string
  # -->
  def rjust: (int size, ?string pad_string) -> String
  # <!--
  #   - rstrip -> new_string
  # -->
  def rstrip: () -> String
  # <!--
